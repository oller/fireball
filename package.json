{
  "name": "fireball",
  "version": "0.1.0",
  "homepage": "https://oller.github.io/fireball/",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "fetch-data": "node ./scripts/fetch-fireball-data.mjs",
    "prebuild": "yarn fetch-data",
    "lint": "vue-cli-service lint",
    "prettier": "prettier --write ./src",
    "test:unit": "vue-cli-service test:unit",
    "test:e2e": "vue-cli-service test:e2e"
  },
  "dependencies": {
    "@deck.gl/core": "^6.1.1",
    "@deck.gl/layers": "^6.1.1",
    "axios": "^0.25.0",
    "bulma": "^0.7.1",
    "d3-scale": "^2.1.2",
    "d3-scale-chromatic": "^1.3.3",
    "date-fns": "^2.22.1",
    "lodash": "^4.17.21",
    "mapbox-gl": "^0.50.0-beta.1",
    "nprogress": "^0.2.0",
    "portal-vue": "^1.4.0",
    "vue": "^2.5.17",
    "vue-router": "^3.0.1",
    "vue-slider-component": "^2.7.11",
    "vue-spinner-component": "^1.0.5",
    "vue-toasted": "^1.1.25"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.15.0",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-e2e-cypress": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-unit-jest": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/eslint-config-prettier": "^6.0.0",
    "@vue/test-utils": "^1.3.0",
    "@vue/vue2-jest": "^27.0.0",
    "babel-core": "7.0.0-bridge.0",
    "babel-jest": "^27.0.0",
    "babel-loader": "^8.2.0",
    "eslint": "^7.32.0",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-vue": "^8.0.0",
    "glob-all": "^3.1.0",
    "jest-serializer-vue": "^2.0.2",
    "jest-transform-stub": "^2.0.0",
    "node-polyfill-webpack-plugin": "^2.0.1",
    "prettier": "^2.4.1",
    "purgecss-webpack-plugin": "^4.0.0",
    "sass": "^1.32.0",
    "sass-loader": "^12.0.0",
    "vue-template-compiler": "^2.5.17"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "jest": {
    "testEnvironment": "jsdom",
    "moduleFileExtensions": [
      "js",
      "jsx",
      "json",
      "vue"
    ],
    "transform": {
      "^.+\\.vue$": "@vue/vue2-jest",
      ".+\\.(css|styl|less|sass|scss|svg|png|jpg|ttf|woff|woff2)$": "jest-transform-stub",
      "^.+\\.jsx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "snapshotSerializers": [
      "jest-serializer-vue"
    ],
    "testMatch": [
      "**/tests/unit/**/*.spec.(js|jsx|ts|tsx)|**/__tests__/*.(js|jsx|ts|tsx)"
    ],
    "testURL": "http://localhost/"
  }
}